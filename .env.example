# BoardRoom provider keys.
# Copy this file to .env and fill in the keys you have.
# BoardRoom detects providers purely from which keys are present.
# Set at least two; set all six to seat the full board.
# Never commit your real .env (it is already in .gitignore).

ANTHROPIC_API_KEY=your-anthropic-key-here       # seats the CEO
OPENAI_API_KEY=your-openai-key-here             # seats the COO
DEEPSEEK_API_KEY=your-deepseek-key-here         # seats the CFO
XAI_API_KEY=your-xai-key-here                   # seats the CTO
GOOGLE_API_KEY=your-google-key-here             # seats the CMO
PERPLEXITY_API_KEY=your-perplexity-key-here     # seats the Devil's Advocate and the research consultant

# ---------------------------------------------------------------------------
# Running without paid keys (optional). BOARDROOM_BACKEND selects the board:
#   auto (default)  the per-vendor keys above, else OpenRouter, else Ollama
#   keys            force the per-vendor keys above
#   openrouter      one key below, every seat routed through OpenRouter
#   ollama          local models via Ollama, no keys and no cost
# Seat keys for per-seat overrides: ANTHROPIC OPENAI DEEPSEEK XAI GOOGLE PERPLEXITY
# ---------------------------------------------------------------------------

# BOARDROOM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# BOARDROOM_OLLAMA_ANTHROPIC=llama3.1   # override a single seat's local model

# BOARDROOM_BACKEND=openrouter
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct   # or a :free slug (openrouter.ai/models?max_price=0)

# ---------------------------------------------------------------------------
# Budget caps (optional)
#
# Enforced BEFORE each call is dispatched, not after it is billed. A call whose
# worst case would breach a cap is refused. CLI flags --session-cap /
# --daily-cap / --weekly-cap override these.
# ---------------------------------------------------------------------------
# BOARDROOM_SESSION_CAP=1.00
# BOARDROOM_DAILY_CAP=5.00
# BOARDROOM_WEEKLY_CAP=20.00
# BOARDROOM_WARN_AT=0.8
