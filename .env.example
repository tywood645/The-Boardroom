# BoardRoom provider keys.
# Copy this file to .env in BoardRoom's project root (next to this file), or to
# ~/.boardroom/.env, and fill in the keys you have. A .env in any other
# directory you run boardroom from is ignored. Keep the file private:
# chmod 600 .env (a file others can write is skipped).
# BoardRoom detects providers purely from which keys are present.
# Set at least two; set all six to seat the full board.
# Never commit your real .env (it is already in .gitignore).

ANTHROPIC_API_KEY=your-anthropic-key-here       # seats the CEO
OPENAI_API_KEY=your-openai-key-here             # seats the COO
DEEPSEEK_API_KEY=your-deepseek-key-here         # seats the CFO
XAI_API_KEY=your-xai-key-here                   # seats the CTO
GOOGLE_API_KEY=your-google-key-here             # seats the CMO
PERPLEXITY_API_KEY=your-perplexity-key-here     # seats the Devil's Advocate and the research consultant

# ---------------------------------------------------------------------------
# Running without paid keys (optional). BOARDROOM_BACKEND selects the board:
#   auto (default)  the per-vendor keys above, else OpenRouter, else Ollama
#   keys            force the per-vendor keys above
#   openrouter      one key below, every seat routed through OpenRouter
#   ollama          local models via Ollama, no keys and no cost
# Seat keys for per-seat overrides: ANTHROPIC OPENAI DEEPSEEK XAI GOOGLE PERPLEXITY
# ---------------------------------------------------------------------------

# BOARDROOM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# BOARDROOM_OLLAMA_ANTHROPIC=llama3.1   # override a single seat's local model

# BOARDROOM_BACKEND=openrouter
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct   # or a :free slug (openrouter.ai/models?max_price=0)
#
# `boardroom delegate` on OpenRouter sends each catalog model as
# <vendor>/<catalog id>. Where OpenRouter names one differently, declare it
# here as catalog-id=openrouter-id, comma separated. Find mismatches with:
#   boardroom delegate --verify-catalog
# BOARDROOM_OPENROUTER_IDS=claude-haiku-4-5-20251001=anthropic/claude-haiku-4.5

# ---------------------------------------------------------------------------
# Budget caps (optional)
#
# Enforced BEFORE each call is dispatched, not after it is billed. A call whose
# worst case would breach a cap is refused. CLI flags --session-cap /
# --daily-cap / --weekly-cap override these.
#
# A value must be a positive amount in USD. Anything else (a typo, 0, "1,00")
# stops the run rather than silently running with no cap. To turn a cap off on
# purpose, set it to "none".
# ---------------------------------------------------------------------------
# BOARDROOM_SESSION_CAP=1.00
# BOARDROOM_DAILY_CAP=5.00
# BOARDROOM_WEEKLY_CAP=20.00
# BOARDROOM_WARN_AT=0.8

# ---------------------------------------------------------------------------
# Prices for models the built-in catalog does not carry (optional)
#
# A model with no catalog entry is priced at the catalog's highest rate, so
# caps still hold; that over-states its cost on the report. Declare the real
# price here as model=input/output in USD per 1M tokens, comma separated.
# ---------------------------------------------------------------------------
# BOARDROOM_MODEL_PRICES=meta-llama/llama-3.1-8b-instruct=0.02/0.05

# ---------------------------------------------------------------------------
# Router tier overrides (optional, vendor:model)
#
# A tier is a price band, not a model alias. By default each tier resolves to
# the cheapest credentialed model in that band. Pin one here to override.
# ---------------------------------------------------------------------------
# BOARDROOM_TIER_CHEAP=deepseek:deepseek-v4-flash
# BOARDROOM_TIER_MID=openai:gpt-4o
# BOARDROOM_TIER_FRONTIER=anthropic:claude-opus-5

# Share of top-tier delegate answers that get checked by another top-tier
# model, from 0 to 1. The check only feeds the routing stats; it never
# escalates. Default 0.2; 0 turns it off.
# BOARDROOM_VERIFY_FRONTIER=0.2

# ── Per-seat model overrides ──────────────────────────────────────────────
# Every board seat takes any model string you like; these defaults are just
# each vendor's current generation at the time of writing, not a constraint.
# BOARDROOM_ANTHROPIC_MODEL=claude-opus-5
# BOARDROOM_OPENAI_MODEL=gpt-5.6-sol
# BOARDROOM_XAI_MODEL=grok-4.5
# BOARDROOM_GOOGLE_MODEL=gemini-3.6-flash
# BOARDROOM_DEEPSEEK_MODEL=deepseek-v4-pro
# BOARDROOM_PERPLEXITY_MODEL=sonar-pro
